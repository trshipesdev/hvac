# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=hvac

# Fallback $/kWh used until a real bill or rate period is parsed.
DEFAULT_RATE_USD_PER_KWH=0.14

# Required for bill + Honeywell/vendor energy-report parsing (Claude Haiku 4.5).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
BILL_PARSER_MODEL=claude-haiku-4-5-20251001
HONEYWELL_PARSER_MODEL=claude-haiku-4-5-20251001

# NOAA weather (optional — synthetic weather is used until this is set).
# Get a free token at https://www.ncdc.noaa.gov/cdo-web/token
# Then find your station via the Settings page's station picker (needs your zip code).
NOAA_TOKEN=
# NOAA_STATION_ID is stored per-property, not here — set it in Settings once running.

# Resideo/Honeywell live thermostat API (optional — mock mode is used until
# these are set AND RESIDEO_MOCK_MODE=false; upload monthly energy reports on
# the Zone Reports page as a workaround in the meantime).
RESIDEO_CLIENT_ID=
RESIDEO_CLIENT_SECRET=
RESIDEO_MOCK_MODE=true

CORS_ORIGINS=*
