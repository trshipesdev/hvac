# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Local project notes — stale draft, not meant for the public repo
memory/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Production builds
/build
dist/
dist

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System files
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Local MongoDB data dir created by run.sh — this is real personal data
# (bills, Green Button intervals, anomaly history), never committed.
.mongo-data/
backend/uvicorn.log
frontend/yarn-start.log

# Environment / credentials
.env
.env.*
*.env
*token.json*
*credentials.json*
*.key
.credentials
# ...but template files are meant to be committed, not secrets themselves.
!**/.env.example

# Real personal utility bills / Green Button exports used for local testing —
# these belong outside the repo (see ~/hvac-sample-data/), never committed.
# Anchored to the repo root only so it doesn't hide legitimate PDFs elsewhere.
/*.pdf
/*.xml
/*.XML
